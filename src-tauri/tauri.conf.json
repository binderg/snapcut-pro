{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ve",
  "version": "0.1.0",
  "identifier": "dev.ve.editor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "ve", "width": 1440, "height": 900, "minWidth": 1100, "minHeight": 700, "dragDropEnabled": true }
    ],
    "security": {
      "csp": null,
      "assetProtocol": { "enable": true, "scope": ["$LOCALDATA/ve/**", "$CACHE/ve/**"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "resources": { "../../plugins/gl-transitions/": "plugins/gl-transitions/" }
  }
}
